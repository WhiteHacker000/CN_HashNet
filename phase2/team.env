# =============================================================================
# Team 1 — Phase 2 single source of truth for the helper scripts.
# Every script in phase2/scripts sources this file. If an IP changes (new
# Wi-Fi lease), update it HERE, then also in:
#   nginx/phase2/edge-*.conf (upstream block) and dns/phase2/team1.hosts
#
# Role map (Phase 2)
#   Mac 1  10.7.11.54   (Kushal) Primary DNS (dnsmasq)            + test client
#   Mac 2  10.7.24.242  (Vansh)  Primary edge (nginx, TLS, LB)
#   Mac 3  10.7.11.60   (Tejas)  Backend A :3001  + BACKUP DNS    (Extension A)
#   Mac 4  10.7.8.22    (Anant)  Backend B :3002  + STANDBY EDGE  (Extension E) + test client
# =============================================================================

APP_HOST=app.team1.test
API_HOST=api.team1.test

DNS_PRIMARY_IP=10.7.11.54
DNS_BACKUP_IP=10.7.11.60

EDGE_PRIMARY_IP=10.7.24.242
EDGE_STANDBY_IP=10.7.8.22
HTTP_PORT=8080
HTTPS_PORT=8443

BACKEND_A_IP=10.7.11.60
BACKEND_A_PORT=3001
BACKEND_B_IP=10.7.8.22
BACKEND_B_PORT=3002

# macOS network service whose DNS servers client-dns.sh changes
# (list them with: networksetup -listallnetworkservices)
NET_SERVICE=Wi-Fi

# Public CA certificate used by diagnose.py to verify the edge (not secret)
CA_CERT=tls/team1-ca.crt
